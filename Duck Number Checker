#include<stdio.h>

void main()
{
    int n,temp,rem,flag=0;

    printf("Enter number: ");
    scanf("%d",&n);

    temp=n;

    while(temp>0)
    {
        rem=temp%10;

        if(rem==0)
            flag=1;

        temp=temp/10;
    }

    if(flag==1 && n>0)
        printf("Duck Number");
    else
        printf("Not Duck Number");
}
