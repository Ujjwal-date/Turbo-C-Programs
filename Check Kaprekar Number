#include<stdio.h>

void main()
{
    long n,square,temp,power=1;
    long left,right;

    printf("Enter number: ");
    scanf("%ld",&n);

    if(n<1)
    {
        printf("Not a Kaprekar Number");
        return;
    }

    square=n*n;
    temp=n;

    while(temp>0)
    {
        power=power*10;
        temp=temp/10;
    }

    left=square/power;
    right=square%power;

    if(left+right==n)
        printf("Kaprekar Number");
    else
        printf("Not a Kaprekar Number");
}
