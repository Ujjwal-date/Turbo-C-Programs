#include<stdio.h>

void main()
{
    int n,temp,sum,rem;

    clrscr();

    printf("Enter a number: ");
    scanf("%d",&n);

    temp=n;

    while(temp>9)
    {
        sum=0;

        while(temp>0)
        {
            rem=temp%10;
            sum=sum+rem;
            temp=temp/10;
        }

        temp=sum;
    }

    if(temp==1)
        printf("Magic Number");
    else
        printf("Not a Magic Number");

    getch();
}
