#include<stdio.h>

void main()
{
    int n,a[20],temp,d=0,i,sum,j;

    printf("Enter number: ");
    scanf("%d",&n);

    temp=n;

    while(temp>0)
    {
        d++;
        temp=temp/10;
    }

    temp=n;

    for(i=d-1;i>=0;i--)
    {
        a[i]=temp%10;
        temp=temp/10;
    }

    while(1)
    {
        sum=0;

        for(i=0;i<d;i++)
            sum=sum+a[i];

        if(sum==n)
        {
            printf("Keith Number");
            return;
        }

        if(sum>n)
            break;

        for(i=0;i<d-1;i++)
            a[i]=a[i+1];

        a[d-1]=sum;
    }

    printf("Not a Keith Number");
}
