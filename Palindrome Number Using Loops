#include<stdio.h>

void main()
{
    int n,temp,rev=0,rem;

    printf("Enter number: ");
    scanf("%d",&n);

    temp=n;

    while(temp>0)
    {
        rem=temp%10;
        rev=rev*10+rem;
        temp=temp/10;
    }

    if(rev==n)
        printf("Palindrome Number");
    else
        printf("Not Palindrome");
}
