#include<stdio.h>

void main()
{
    int n,i,j,flag1,flag2;

    printf("Enter limit: ");
    scanf("%d",&n);

    for(i=2;i<=n-2;i++)
    {
        flag1=1;
        flag2=1;

        for(j=2;j*j<=i;j++)
            if(i%j==0)
                flag1=0;

        for(j=2;j*j<=i+2;j++)
            if((i+2)%j==0)
                flag2=0;

        if(flag1==1 && flag2==1)
            printf("(%d,%d)\n",i,i+2);
    }
}
