#include<stdio.h>

void main()
{
    long n,x;
    int count[10]={0};
    int i,flag=1,d;

    clrscr();

    printf("Enter a three-digit number: ");
    scanf("%ld",&n);

    if(n<100 || n>999)
    {
        printf("Enter a three-digit number only");
        getch();
        return;
    }

    for(i=1;i<=3;i++)
    {
        x=n*i;

        while(x>0)
        {
            d=x%10;
            count[d]++;
            x=x/10;
        }
    }

    if(count[0]!=0)
        flag=0;

    for(i=1;i<=9;i++)
    {
        if(count[i]!=1)
            flag=0;
    }

    if(flag==1)
        printf("Fascinating Number");
    else
        printf("Not a Fascinating Number");

    getch();
}
