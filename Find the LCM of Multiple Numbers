#include<stdio.h>

void main()
{
    int n,a[50],i,max,lcm,found;

    printf("Enter how many numbers: ");
    scanf("%d",&n);

    printf("Enter numbers: ");

    for(i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }

    max=a[0];

    for(i=1;i<n;i++)
    {
        if(a[i]>max)
            max=a[i];
    }

    lcm=max;

    while(1)
    {
        found=1;

        for(i=0;i<n;i++)
        {
            if(lcm%a[i]!=0)
            {
                found=0;
                break;
            }
        }

        if(found==1)
            break;

        lcm=lcm+max;
    }

    printf("LCM of all numbers = %d",lcm);
}
