#include<stdio.h>

void main()
{
    int a,b,i,sum1=0,sum2=0;

    printf("Enter two numbers: ");
    scanf("%d%d",&a,&b);

    for(i=1;i<a;i++)
    {
        if(a%i==0)
            sum1=sum1+i;
    }

    for(i=1;i<b;i++)
    {
        if(b%i==0)
            sum2=sum2+i;
    }

    if(sum1==b && sum2==a && a!=b)
        printf("Amicable Numbers");
    else
        printf("Not Amicable Numbers");
}
