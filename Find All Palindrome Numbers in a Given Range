#include<stdio.h>

void main()
{
    int start,end,i,temp,rev,rem;

    clrscr();

    printf("Enter starting range: ");
    scanf("%d",&start);

    printf("Enter ending range: ");
    scanf("%d",&end);

    printf("Palindrome numbers are:\n");

    for(i=start;i<=end;i++)
    {
        if(i<0)
            continue;

        temp=i;
        rev=0;

        while(temp>0)
        {
            rem=temp%10;
            rev=rev*10+rem;
            temp=temp/10;
        }

        if(rev==i)
            printf("%d ",i);
    }

    getch();
}
