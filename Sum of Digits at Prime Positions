#include<stdio.h>

void main()
{
    int n,rem,pos=1,i,flag,sum=0;

    clrscr();

    printf("Enter number: ");
    scanf("%d",&n);

    while(n>0)
    {
        rem=n%10;
        flag=1;

        if(pos<=1)
            flag=0;

        for(i=2;i<pos;i++)
        {
            if(pos%i==0)
            {
                flag=0;
                break;
            }
        }

        if(flag==1)
            sum=sum+rem;

        pos++;
        n=n/10;
    }

    printf("Sum = %d",sum);

    getch();
}
