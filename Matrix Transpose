#include <stdio.h>

void main()
{
    int a[10][10], r, c, i, j;

    clrscr();

    printf("Enter rows and columns: ");
    scanf("%d%d", &r, &c);

    printf("Enter matrix elements:\n");

    for(i = 0; i < r; i++)
    {
        for(j = 0; j < c; j++)
            scanf("%d", &a[i][j]);
    }

    printf("\nTranspose of Matrix:\n");

    for(j = 0; j < c; j++)
    {
        for(i = 0; i < r; i++)
            printf("%d\t", a[i][j]);

        printf("\n");
    }

    getch();
}
