#include <stdio.h>

void main()
{
    int a[100], n, i;
    int largest, second;

    clrscr();

    printf("Enter array size: ");
    scanf("%d", &n);

    if(n < 2 || n > 100)
    {
        printf("Invalid array size");
        getch();
        return;
    }

    printf("Enter array elements:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    largest = a[0];
    second = 0;

    for(i = 1; i < n; i++)
    {
        if(a[i] > largest)
        {
            second = largest;
            largest = a[i];
        }
        else if(a[i] < largest &&
                (second == 0 || a[i] > second))
        {
            second = a[i];
        }
    }

    printf("Largest element = %d", largest);

    if(second == 0)
        printf("\nNo second largest distinct element");
    else
        printf("\nSecond largest = %d", second);

    getch();
}
