#include<stdio.h>

void main()
{
    int n,i;

    printf("Enter number: ");
    scanf("%d",&n);

    printf("Prime factors are: ");

    for(i=2;i<=n;i++)
    {
        if(n%i==0)
        {
            int flag=1,j;

            for(j=2;j*j<=i;j++)
            {
                if(i%j==0)
                {
                    flag=0;
                    break;
                }
            }

            if(flag==1)
            {
                printf("%d ",i);

                while(n%i==0)
                    n=n/i;
            }
        }
    }
}
