#include<stdio.h>

void main()
{
    int n,sum,rem;

    printf("Enter number: ");
    scanf("%d",&n);

    while(n>=10)
    {
        sum=0;

        while(n>0)
        {
            rem=n%10;
            sum=sum+rem;
            n=n/10;
        }

        n=sum;
    }

    printf("Digital Root = %d",n);
}
