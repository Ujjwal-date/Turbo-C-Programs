#include<stdio.h>

void main()
{
    int n,i,j,fact;
    float sum=0,term;

    clrscr();

    printf("Enter number of terms: ");
    scanf("%d",&n);

    for(i=1;i<=n;i++)
    {
        fact=1;

        for(j=1;j<=i;j++)
        {
            fact=fact*j;
        }

        term=(float)i/fact;
        sum=sum+term;
    }

    printf("Sum of series = %.4f",sum);

    getch();
}
