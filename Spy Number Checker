#include<stdio.h>

void main()
{
    int n,temp,rem,sum=0,product=1;

    printf("Enter number: ");
    scanf("%d",&n);

    temp=n;

    while(temp>0)
    {
        rem=temp%10;
        sum=sum+rem;
        product=product*rem;
        temp=temp/10;
    }

    if(sum==product)
        printf("Spy Number");
    else
        printf("Not Spy Number");
}
