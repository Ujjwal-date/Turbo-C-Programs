#include<stdio.h>

void main()
{
    int n,temp,rev=0,rem,i;
    int flag1=1,flag2=1;

    printf("Enter number: ");
    scanf("%d",&n);

    for(i=2;i*i<=n;i++)
    {
        if(n%i==0)
        {
            flag1=0;
            break;
        }
    }

    temp=n;

    while(temp>0)
    {
        rem=temp%10;
        rev=rev*10+rem;
        temp=temp/10;
    }

    if(rev<2)
        flag2=0;

    for(i=2;i*i<=rev;i++)
    {
        if(rev%i==0)
        {
            flag2=0;
            break;
        }
    }

    if(flag1==1 && flag2==1 && n!=rev && n>1)
        printf("Emirp Number");
    else
        printf("Not an Emirp Number");
}
